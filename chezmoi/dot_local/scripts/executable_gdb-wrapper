#!/bin/bash
#

if which udb && false;
then
    exec udb \
        -iex "dir $(sbroot)/matlab" \
        -iex "set substitute-path /matlab $(sbroot)/matlab" \
        -cd "$(pwd)" \
        "$@"
else
    exec gdb \
        -iex "dir $(sbroot)/matlab" \
        -iex "set substitute-path /matlab $(sbroot)/matlab" \
        -cd "$(pwd)" \
        "$@"
fi
